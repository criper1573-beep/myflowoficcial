# Пример location для script.flowcabinet.ru.
# Это образец заголовка автора. Живой nginx этим файлом не заменяется.
# Basic auth и сертификаты остаются как на сервере.

location /assets/ {
    alias /var/www/script-flowcabinet/assets/;
}

location / {
    proxy_pass http://127.0.0.1:8780;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Remote-User $remote_user;
}
