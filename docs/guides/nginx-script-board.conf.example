# Пример виртуального хоста для script.flowcabinet.ru.
# Это образец для документации. Рабочий конфиг nginx на сервере этим файлом не заменяется.
#
# Basic auth уже стоит перед сервисом. $remote_user — логин из auth_basic
# (alexey или sonya). Бэкенд читает его как автора правки.

server {
    listen 443 ssl;
    server_name script.flowcabinet.ru;

    # ssl_certificate     /etc/letsencrypt/live/script.flowcabinet.ru/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/script.flowcabinet.ru/privkey.pem;

    auth_basic "Script Board";
    auth_basic_user_file /etc/nginx/.htpasswd-script-board;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8780;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Remote-User $remote_user;
    }
}
